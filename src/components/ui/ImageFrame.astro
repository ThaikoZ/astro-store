---
/**
 * Tall portrait media frame (pill silhouette).
 * Pass an `<img>` or stacked images via the default slot.
 */
interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<div
	class:list={[
		'relative mx-auto aspect-square w-full max-w-none overflow-hidden rounded-[5rem] lg:aspect-5/6 lg:max-w-md lg:rounded-[10rem]',
		className,
	]}
>
	<slot />
</div>
