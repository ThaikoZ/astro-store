---
import Button from '../ui/Button.astro';
import type { ProductCardModel } from '../../lib/shop/mapProductCard';

interface Props {
	product: ProductCardModel;
}

const { product } = Astro.props;
const headingId = `product-${product.databaseId}`;
---

<article class="group flex h-full flex-col" aria-labelledby={headingId}>
	<div class="aspect-4/5 overflow-hidden bg-ink/5">
		{
			product.imageUrl ? (
				<img
					src={product.imageUrl}
					alt={product.imageAlt}
					class="size-full object-cover object-[center_28%] transition-transform duration-500 ease-out group-hover:scale-[1.03] motion-reduce:transition-none motion-reduce:group-hover:scale-100"
					loading="lazy"
					decoding="async"
				/>
			) : (
				<div class="flex size-full items-center justify-center font-sans text-xs tracking-[0.14em] text-ink/40 uppercase">
					Brak zdjęcia
				</div>
			)
		}
	</div>

	<div class="mt-6 flex flex-1 flex-col items-center text-center md:mt-7">
		<h2
			id={headingId}
			class="m-0 max-w-[18ch] font-display text-[clamp(1.05rem,2vw,1.35rem)] font-normal leading-snug tracking-[0.12em] text-ink uppercase"
		>
			{product.name}
		</h2>

		<p class="mt-3 m-0 font-sans text-sm tracking-[0.08em] text-ink/80 md:text-[0.95rem]">
			{product.priceLabel}
		</p>

		<div class="mt-5 w-full max-w-xs md:mt-6">
			{
				product.canAddToCart ? (
					<Button
						variant="solid"
						tone="ink"
						class="w-full"
						data-add-to-cart
						data-product-id={product.databaseId}
					>
						Dodaj do koszyka
					</Button>
				) : (
					<Button variant="solid" tone="ink" class="w-full" disabled>
						{product.stockLabel ?? 'Niedostępne'}
					</Button>
				)
			}
		</div>
	</div>
</article>
