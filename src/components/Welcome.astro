---
import SiteFooter from './site/SiteFooter.astro';
import SiteHeader from './site/SiteHeader.astro';
import { IMAGES, OFFER_LINKS, SOCIAL, TESTIMONIALS } from '../lib/site';

const marqueeLogos = Array.from({ length: 12 }, () => IMAGES.marqueeLogo);
---

<div class="min-h-full bg-foam text-ink">
	<SiteHeader variant="overlay" />

	<main id="tresc">
		<section
			class="relative isolate flex h-svh flex-col overflow-hidden text-foam"
			aria-label="Wstęp"
		>
			<img
				class="absolute inset-0 -z-20 size-full object-cover object-[center_27%]"
				src={IMAGES.hero}
				alt=""
				fetchpriority="high"
			/>
			<div
				class="absolute inset-0 -z-10 bg-linear-to-b from-black/30 via-black/40 to-black/85"
				aria-hidden="true"
			>
			</div>

			<div
				class="flex flex-1 flex-col items-center justify-end gap-7 px-6 pb-12 pt-28 text-center md:px-10 md:pb-16"
			>
				<h1
					class="m-0 max-w-[18ch] font-display text-[clamp(1.45rem,3.6vw,2.15rem)] font-normal leading-[1.35] text-foam animate-rise motion-reduce:animate-none"
				>
					Nazywam się Klaudia Jaranowska
					<br />
					i jestem dyplomowaną
					<br />
					makijażystką oraz
					<br />
					szkoleniowcem.
				</h1>
				<a
					class="font-display text-[clamp(0.95rem,2vw,1.1rem)] font-normal tracking-[0.14em] text-foam no-underline uppercase transition-opacity duration-200 hover:opacity-70 animate-rise motion-reduce:animate-none [animation-delay:140ms]"
					href="#oferta"
				>
					Poznaj moją ofertę
				</a>
				<a
					href="#oferta"
					class="mt-2 text-foam/80 transition-opacity hover:opacity-100 animate-rise motion-reduce:animate-none [animation-delay:240ms]"
					aria-label="Przejdź do oferty"
				>
					<svg
						xmlns="http://www.w3.org/2000/svg"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="1.25"
						class="size-6"
						aria-hidden="true"
					>
						<path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round"></path>
					</svg>
				</a>
			</div>
			<p class="sr-only">Klaudia Jaranowska</p>
		</section>

		<div class="overflow-hidden bg-ink py-3.5" aria-hidden="true">
			<div class="flex w-max items-center animate-marquee motion-reduce:animate-none">
				{
					[...marqueeLogos, ...marqueeLogos].map((src) => (
						<img
							src={src}
							alt=""
							class="mx-6 h-5 w-auto opacity-95 md:mx-8 md:h-6"
							width="180"
							height="24"
							loading="lazy"
						/>
					))
				}
			</div>
		</div>

		<section
			id="oferta"
			class="bg-paper px-6 py-16 md:px-10 md:py-24"
			aria-labelledby="oferta-heading"
			data-offer
		>
			<div class="mx-auto grid max-w-6xl items-center gap-10 md:grid-cols-2 md:gap-14 lg:gap-20">
				<div class="relative mx-auto aspect-5/6 w-full max-w-md overflow-hidden rounded-[10rem] md:mx-0">
					{
						OFFER_LINKS.map((item, index) => (
							<img
								src={item.image}
								alt=""
								class:list={[
									'absolute inset-0 size-full object-cover object-center transition-opacity duration-500 ease-out motion-reduce:transition-none',
									index === 0 ? 'opacity-100' : 'opacity-0',
								]}
								data-offer-image
								data-index={index}
								loading={index === 0 ? 'eager' : 'lazy'}
								width="800"
								height="1067"
							/>
						))
					}
				</div>

				<div>
					<h2
						id="oferta-heading"
						class="m-0 font-display text-[clamp(1.6rem,3.2vw,2.25rem)] font-normal tracking-[0.16em] text-ink uppercase"
					>
						Oferta
					</h2>
					<ul class="mt-8 m-0 list-none border-t border-ink p-0 md:mt-10">
						{
							OFFER_LINKS.map((item, index) => (
								<li class="border-b border-ink">
									<a
										href={item.href}
										class="group flex items-center justify-between gap-4 py-2.5 font-display text-[clamp(1rem,2.2vw,1.2rem)] tracking-[0.04em] text-ink no-underline transition-opacity hover:opacity-70 md:py-4"
										data-offer-link
										data-index={index}
										aria-current={index === 0 ? 'true' : undefined}
									>
										<span>{item.label}</span>
										<svg
											class="w-6 shrink-0 transition-transform duration-300 group-hover:translate-x-1 motion-reduce:transition-none"
											viewBox="0 0 24 24"
											fill="none"
											stroke="currentColor"
											stroke-width="1"
											aria-hidden="true"
										>
											<path d="M4 12h15" stroke-linecap="round"></path>
											<path d="M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"></path>
										</svg>
									</a>
								</li>
							))
						}
					</ul>
				</div>
			</div>
		</section>

		<section
			id="o-mnie"
			class="bg-foam px-6 py-16 md:px-10 md:py-24"
			aria-labelledby="about-heading"
		>
			<div class="mx-auto grid max-w-6xl items-center gap-10 md:grid-cols-2 md:gap-14 lg:gap-20">
				<div class="order-2 text-left md:order-1">
					<h3
						id="about-heading"
						class="m-0 font-display text-[clamp(1.45rem,3vw,2.1rem)] font-normal leading-tight text-ink"
					>
						Sprawię, że poczujesz się
						<span class="mt-2 block font-display italic tracking-[0.08em] uppercase">
							pięknie i pewnie!
						</span>
					</h3>
					<p class="mt-6 m-0 max-w-xl font-sans text-sm leading-relaxed text-ink/80 md:text-base">
						Moja pasja do makijażu to połączenie doświadczenia, wiedzy i indywidualnego
						podejścia do każdego klienta.
					</p>
					<p class="mt-4 m-0 max-w-xl font-sans text-sm leading-relaxed text-ink/80 md:text-base">
						Moim celem nie jest tylko wykonanie pięknego makijażu - chcę, aby każda kobieta,
						która siada na moim fotelu, poczuła się wyjątkowo i komfortowo. Niezależnie od
						tego, czy przygotowujesz się do ślubu, ważnego wydarzenia, sesji zdjęciowej, czy
						po prostu chcesz poczuć się pięknie - jestem tu, aby sprawić, byś poczuła się
						pięknie i pewnie!
					</p>
					<a
						href="/kontakt/"
						class="mt-8 inline-block bg-ink px-8 py-3.5 font-sans text-xs tracking-[0.18em] text-foam no-underline uppercase shadow-sm transition-opacity hover:opacity-80"
					>
						Dowiedz się więcej
					</a>
				</div>
				<div
					class="relative order-1 mx-auto aspect-5/6 w-full max-w-md overflow-hidden rounded-[10rem] md:order-2 md:ml-auto md:mr-0"
				>
					<img
						class="size-full object-cover object-top"
						src={IMAGES.about}
						alt="Klaudia Jaranowska przy pracy"
						loading="lazy"
						width="750"
						height="1024"
					/>
				</div>
			</div>
		</section>

		<section
			id="opinie"
			class="bg-foam px-6 pb-16 md:px-10 md:pb-24"
			aria-labelledby="testimonials-heading"
		>
			<header class="mx-auto mb-10 max-w-2xl text-center md:mb-14">
				<h2
					id="testimonials-heading"
					class="m-0 font-display text-[clamp(1.5rem,3vw,2rem)] font-normal tracking-[0.12em] text-ink uppercase"
				>
					Wasze słowa
				</h2>
				<p class="mt-4 m-0 font-sans text-sm leading-relaxed text-ink/80 md:text-base">
					Nie ma dla mnie większego komplementu niż uśmiech na twarzy klientki po zakończonym
					makijażu. Wasze opinie są dla mnie ogromnym źródłem motywacji i inspiracji do
					dalszego rozwoju.
				</p>
			</header>

			<div class="mx-auto max-w-3xl" data-testimonials>
				<div class="relative min-h-[12rem] text-center" aria-live="polite">
					{
						TESTIMONIALS.map((item, index) => (
							<figure
								class:list={[
									'testimonial-slide m-0 px-4',
									index === 0 ? 'block' : 'hidden',
								]}
								data-testimonial-slide
								data-index={index}
							>
								<img
									src={IMAGES.quoteMarks}
									alt=""
									class="mx-auto mb-5 h-8 w-auto opacity-80"
									width="64"
									height="32"
									loading="lazy"
									aria-hidden="true"
								/>
								<blockquote class="m-0">
									<p class="m-0 font-display text-base leading-relaxed text-ink/90 italic md:text-lg">
										“{item.quote}”
									</p>
								</blockquote>
								<figcaption class="mt-5 font-sans text-xs tracking-[0.18em] text-muted uppercase">
									-{item.author}
								</figcaption>
							</figure>
						))
					}
				</div>
				<div class="mt-8 flex items-center justify-center gap-6">
					<button
						type="button"
						class="border-0 bg-transparent font-sans text-xs tracking-[0.18em] text-ink uppercase opacity-70 transition-opacity hover:opacity-100"
						data-testimonial-prev
						aria-label="Poprzednia opinia"
					>
						Poprzedni
					</button>
					<button
						type="button"
						class="border-0 bg-transparent font-sans text-xs tracking-[0.18em] text-ink uppercase opacity-70 transition-opacity hover:opacity-100"
						data-testimonial-next
						aria-label="Następna opinia"
					>
						Następny
					</button>
				</div>
			</div>
		</section>

		<section
			id="instagram"
			class="relative isolate overflow-hidden px-6 py-20 text-foam md:px-10 md:py-28"
			aria-labelledby="instagram-heading"
		>
			<img
				class="absolute inset-0 -z-20 size-full object-cover object-center"
				src={IMAGES.instagram}
				alt=""
				loading="lazy"
			/>
			<div class="absolute inset-0 -z-10 bg-black/55" aria-hidden="true"></div>
			<div class="mx-auto max-w-2xl text-center">
				<h2
					id="instagram-heading"
					class="m-0 font-display text-[clamp(1.5rem,3vw,2.1rem)] font-normal tracking-[0.06em] text-foam"
				>
					Zobacz jak pracuję!
				</h2>
				<p class="mt-4 m-0 font-sans text-sm leading-relaxed text-foam/85 md:text-base">
					Zajrzyj na Instagram - tam czeka więcej makijażowych metamorfoz, kulisy pracy i
					inspiracje!
				</p>
				<a
					href={SOCIAL.instagram}
					class="mt-8 inline-block font-display text-sm tracking-[0.14em] text-foam no-underline uppercase transition-opacity hover:opacity-70"
					rel="noopener noreferrer"
					target="_blank"
				>
					Obserwuj mnie na Insta!
				</a>
			</div>
		</section>
	</main>

	<SiteFooter />
</div>

<script>
	function initOffer() {
		const root = document.querySelector('[data-offer]');
		if (!(root instanceof HTMLElement)) return;
		if (root.dataset.offerBound === 'true') return;
		root.dataset.offerBound = 'true';

		const images = [...root.querySelectorAll('[data-offer-image]')];
		const links = [...root.querySelectorAll('[data-offer-link]')];
		if (images.length === 0 || links.length === 0) return;

		const setActive = (index: number) => {
			images.forEach((image, i) => {
				image.classList.toggle('opacity-100', i === index);
				image.classList.toggle('opacity-0', i !== index);
			});
			links.forEach((link, i) => {
				if (i === index) link.setAttribute('aria-current', 'true');
				else link.removeAttribute('aria-current');
			});
		};

		links.forEach((link) => {
			const index = Number(link.getAttribute('data-index'));
			if (Number.isNaN(index)) return;
			link.addEventListener('mouseenter', () => setActive(index));
			link.addEventListener('focus', () => setActive(index));
		});
	}

	function initTestimonials() {
		const root = document.querySelector('[data-testimonials]');
		if (!(root instanceof HTMLElement)) return;

		const slides = [...root.querySelectorAll('[data-testimonial-slide]')];
		if (slides.length === 0) return;

		let index = 0;
		const show = (next: number) => {
			index = (next + slides.length) % slides.length;
			slides.forEach((slide, i) => {
				slide.classList.toggle('hidden', i !== index);
				slide.classList.toggle('block', i === index);
			});
		};

		root.querySelector('[data-testimonial-prev]')?.addEventListener('click', () => show(index - 1));
		root.querySelector('[data-testimonial-next]')?.addEventListener('click', () => show(index + 1));
	}

	function initLanding() {
		initOffer();
		initTestimonials();
	}

	initLanding();
	document.addEventListener('astro:page-load', initLanding);
</script>
