---
import InstagramSection from './site/InstagramSection.astro';
import SiteFooter from './site/SiteFooter.astro';
import SiteHeader from './site/SiteHeader.astro';
import Button from './ui/Button.astro';
import Container from './ui/Container.astro';
import ImageFrame from './ui/ImageFrame.astro';
import { IMAGES, OFFER_LINKS, SOCIAL, TESTIMONIALS } from '../lib/site';

const marqueeLogos = Array.from({ length: 12 }, () => IMAGES.marqueeLogo);
const DEFAULT_OFFER_INDEX = OFFER_LINKS.findIndex((item) => item.href === '/lekcja-makijazu/');
const defaultOfferIndex = DEFAULT_OFFER_INDEX >= 0 ? DEFAULT_OFFER_INDEX : 0;
---

<div class="min-h-full bg-foam text-ink">
	<SiteHeader variant="overlay" />

	<main id="tresc">
		<section
			class="relative isolate flex h-svh flex-col overflow-hidden text-foam"
			aria-label="Wstęp"
		>
			<img
				class="absolute inset-0 -z-20 size-full object-cover object-[center_27%]"
				src={IMAGES.hero}
				alt=""
				fetchpriority="high"
			/>
			<div
				class="absolute inset-0 -z-10 bg-linear-to-b from-black/30 via-black/40 to-black/85"
				aria-hidden="true"
			>
			</div>

			<Container
				class="flex flex-1 flex-col items-center justify-end gap-7 pb-12 pt-28 text-center md:pb-16"
			>
				<h1
					class="m-0 max-w-[28ch] font-display text-[clamp(1.45rem,3.6vw,2.15rem)] font-normal leading-[1.35] text-foam animate-rise motion-reduce:animate-none"
				>
					Nazywam się Klaudia Jaranowska
					<br />
					i jestem dyplomowaną makijażystką
					<br />
					oraz szkoleniowcem.
				</h1>
				<Button
					href="#oferta"
					variant="text"
					tone="foam"
					class="animate-rise motion-reduce:animate-none [animation-delay:140ms]"
				>
					Poznaj moją ofertę
				</Button>
				<a
					href="#oferta"
					class="mt-2 text-foam/80 transition-opacity hover:opacity-100 animate-rise motion-reduce:animate-none [animation-delay:240ms]"
					aria-label="Przejdź do oferty"
				>
					<svg
						xmlns="http://www.w3.org/2000/svg"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="1.25"
						class="size-6"
						aria-hidden="true"
					>
						<path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round"></path>
					</svg>
				</a>
			</Container>
			<p class="sr-only">Klaudia Jaranowska</p>
		</section>

		<div class="overflow-hidden bg-ink py-3.5" aria-hidden="true">
			<div class="flex w-max items-center animate-marquee motion-reduce:animate-none">
				{
					[...marqueeLogos, ...marqueeLogos].map((src) => (
						<img
							src={src}
							alt=""
							class="mx-6 h-5 w-auto opacity-95 md:mx-8 md:h-6"
							width="180"
							height="24"
							loading="lazy"
						/>
					))
				}
			</div>
		</div>

		<section
			id="oferta"
			class="bg-paper py-20 md:py-28"
			aria-labelledby="oferta-heading"
			data-offer
			data-offer-default={defaultOfferIndex}
		>
			<Container class="grid items-center gap-12 md:grid-cols-2 md:gap-16 lg:gap-20">
				<ImageFrame class="md:mx-0 md:aspect-5/6 md:max-w-md md:rounded-[10rem]">
					{
						OFFER_LINKS.map((item, index) => (
							<img
								src={item.image}
								alt=""
								class:list={[
									'absolute inset-0 size-full object-cover object-[center_32%] transition-opacity duration-500 ease-out motion-reduce:transition-none',
									index === defaultOfferIndex ? 'opacity-100' : 'opacity-0',
								]}
								data-offer-image
								data-index={index}
								loading={index === defaultOfferIndex ? 'eager' : 'lazy'}
								width="800"
								height="1067"
							/>
						))
					}
				</ImageFrame>

				<div>
					<h2
						id="oferta-heading"
						class="m-0 font-display text-[clamp(1.5rem,3vw,2.1rem)] font-normal tracking-[0.14em] text-ink uppercase"
					>
						Oferta
					</h2>
					<ul class="mt-8 m-0 list-none border-t border-ink p-0 md:mt-10">
						{
							OFFER_LINKS.map((item, index) => (
								<li class="border-b border-ink">
									<a
										href={item.href}
										class="group flex items-center justify-between gap-4 py-4 font-display text-[clamp(1rem,2.2vw,1.2rem)] tracking-[0.04em] text-ink no-underline transition-opacity hover:opacity-70 md:py-3"
										data-offer-link
										data-index={index}
										aria-current={index === defaultOfferIndex ? 'true' : undefined}
									>
										<span>{item.label}</span>
										<svg
											class="w-6 shrink-0 transition-transform duration-300 group-hover:translate-x-1 motion-reduce:transition-none"
											viewBox="0 0 24 24"
											fill="none"
											stroke="currentColor"
											stroke-width="1"
											aria-hidden="true"
										>
											<path d="M4 12h15" stroke-linecap="round"></path>
											<path d="M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"></path>
										</svg>
									</a>
								</li>
							))
						}
					</ul>
				</div>
			</Container>
		</section>

		<section
			id="o-mnie"
			class="bg-foam py-20 md:py-28"
			aria-labelledby="about-heading"
		>
			<Container class="grid items-center gap-12 md:grid-cols-2 md:gap-16 lg:gap-20">
				<div class="order-2 text-center md:order-1 md:text-left">
					<h3
						id="about-heading"
						class="m-0 font-display text-[clamp(1.45rem,3vw,2.1rem)] font-normal leading-tight text-ink"
					>
						Sprawię, że poczujesz się
						<span class="mt-2 block font-display italic tracking-[0.08em] uppercase">
							pięknie i pewnie!
						</span>
					</h3>
					<p class="mx-auto mt-6 m-0 max-w-xl font-sans text-sm leading-relaxed text-ink/80 md:mx-0 md:text-[0.95rem] md:leading-7">
						Moja pasja do makijażu to połączenie doświadczenia, wiedzy i indywidualnego
						podejścia do każdego klienta.
					</p>
					<p class="mx-auto mt-5 m-0 max-w-xl font-sans text-sm leading-relaxed text-ink/80 md:mx-0 md:text-[0.95rem] md:leading-7">
						Moim celem nie jest tylko wykonanie pięknego makijażu - chcę, aby każda kobieta,
						która siada na moim fotelu, poczuła się wyjątkowo i komfortowo. Niezależnie od
						tego, czy przygotowujesz się do ślubu, ważnego wydarzenia, sesji zdjęciowej, czy
						po prostu chcesz poczuć się pięknie - jestem tu, aby sprawić, byś poczuła się
						pięknie i pewnie!
					</p>
					<Button href="/kontakt/" variant="solid" tone="ink" class="mt-10">
						Dowiedz się więcej
					</Button>
				</div>
				<ImageFrame class="order-1 -mx-6 w-[calc(100%+3rem)] max-w-none md:order-2 md:mx-0 md:ml-auto md:mr-0 md:w-full lg:max-w-md">
					<img
						class="size-full object-cover object-top"
						src={IMAGES.about}
						alt="Klaudia Jaranowska przy pracy"
						loading="lazy"
						width="750"
						height="1024"
					/>
				</ImageFrame>
			</Container>
		</section>

		<div class="bg-brand-gray py-5 md:py-6">
			<Container>
				<a
					href="/szkolenia-stacjonarne/"
					class="flex items-center justify-center gap-3 font-display text-sm tracking-[0.16em] text-ink no-underline uppercase transition-opacity hover:opacity-70 md:text-base"
				>
					Zobacz szkolenia stacjonarne
					<svg
						class="size-5 shrink-0"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="1.25"
						aria-hidden="true"
					>
						<path d="M4 12h15" stroke-linecap="round"></path>
						<path d="M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"></path>
					</svg>
				</a>
			</Container>
		</div>

		<section
			id="opinie"
			class="bg-foam py-20 md:py-28"
			aria-labelledby="testimonials-heading"
		>
			<Container>
			<header class="mx-auto mb-12 max-w-2xl text-center md:mb-16">
				<h2
					id="testimonials-heading"
					class="m-0 font-display text-[clamp(1.5rem,3vw,2.1rem)] font-normal tracking-[0.14em] text-ink uppercase"
				>
					Wasze słowa
				</h2>
				<p class="mt-5 m-0 font-sans text-sm leading-relaxed text-ink/80 md:text-[0.95rem] md:leading-7">
					Nie ma dla mnie większego komplementu niż uśmiech na twarzy klientki po zakończonym
					makijażu. Wasze opinie są dla mnie ogromnym źródłem motywacji i inspiracji do
					dalszego rozwoju.
				</p>
			</header>

			<div class="flex items-center gap-2 md:gap-4" data-testimonials>
				<button
					type="button"
					class="flex size-10 shrink-0 cursor-pointer items-center justify-center border-0 bg-transparent text-ink transition-opacity hover:opacity-60"
					data-testimonial-prev
					aria-label="Poprzednie opinie"
				>
					<svg class="size-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true">
						<path d="M15 6l-6 6 6 6" stroke-linecap="round" stroke-linejoin="round"></path>
					</svg>
				</button>

				<div class="min-w-0 flex-1 overflow-hidden" aria-live="polite">
					<div
						class="flex transition-transform duration-500 ease-out motion-reduce:transition-none"
						data-testimonials-track
					>
						{
							[...TESTIMONIALS, ...TESTIMONIALS].map((item) => (
								<figure
									class="m-0 w-full shrink-0 grow-0 basis-full px-3 text-center sm:basis-1/2 lg:basis-1/3"
									data-testimonial-slide
								>
									<img
										src={IMAGES.quoteMarks}
										alt=""
										class="mx-auto mb-4 h-3 w-auto opacity-80"
										width="64"
										height="32"
										loading="lazy"
										aria-hidden="true"
									/>
									<blockquote class="m-0">
										<p class="m-0 font-display text-base leading-relaxed text-ink/90 italic md:text-lg">
											“{item.quote}”
										</p>
									</blockquote>
									<figcaption class="mt-5 font-sans text-xs tracking-[0.18em] text-muted uppercase">
										-{item.author}
									</figcaption>
								</figure>
							))
						}
					</div>
				</div>

				<button
					type="button"
					class="flex size-10 shrink-0 cursor-pointer items-center justify-center border-0 bg-transparent text-ink transition-opacity hover:opacity-60"
					data-testimonial-next
					aria-label="Następne opinie"
				>
					<svg class="size-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true">
						<path d="M9 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"></path>
					</svg>
				</button>
			</div>
			</Container>
		</section>

		<InstagramSection
			heading="Zobacz jak pracuję!"
			description="Zajrzyj na Instagram - tam czeka więcej makijażowych metamorfoz, kulisy pracy i inspiracje!"
			ctaLabel="Obserwuj mnie na Insta!"
			ctaHref={SOCIAL.instagram}
			ctaTarget="_blank"
			ctaRel="noopener noreferrer"
			items={OFFER_LINKS}
		/>
	</main>

	<SiteFooter />
</div>

<script>
	function initOffer() {
		const root = document.querySelector('[data-offer]');
		if (!(root instanceof HTMLElement)) return;
		if (root.dataset.offerBound === 'true') return;
		root.dataset.offerBound = 'true';

		const images = [...root.querySelectorAll('[data-offer-image]')];
		const links = [...root.querySelectorAll('[data-offer-link]')];
		if (images.length === 0 || links.length === 0) return;

		const defaultIndex = Number(root.getAttribute('data-offer-default') ?? '0');

		const setActive = (index: number) => {
			images.forEach((image, i) => {
				image.classList.toggle('opacity-100', i === index);
				image.classList.toggle('opacity-0', i !== index);
			});
			links.forEach((link, i) => {
				if (i === index) link.setAttribute('aria-current', 'true');
				else link.removeAttribute('aria-current');
			});
		};

		setActive(Number.isNaN(defaultIndex) ? 0 : defaultIndex);

		links.forEach((link) => {
			const index = Number(link.getAttribute('data-index'));
			if (Number.isNaN(index)) return;
			link.addEventListener('mouseenter', () => setActive(index));
			link.addEventListener('focus', () => setActive(index));
		});
	}

	function initTestimonials() {
		const root = document.querySelector('[data-testimonials]');
		if (!(root instanceof HTMLElement)) return;
		if (root.dataset.testimonialsBound === 'true') return;
		root.dataset.testimonialsBound = 'true';

		const track = root.querySelector('[data-testimonials-track]');
		const slides = [...root.querySelectorAll('[data-testimonial-slide]')];
		if (!(track instanceof HTMLElement) || slides.length === 0) return;

		// Track is duplicated once for seamless looping.
		const uniqueCount = slides.length / 2;
		let index = 0;
		let locked = false;

		const visibleCount = () => {
			if (window.matchMedia('(min-width: 1024px)').matches) return Math.min(3, uniqueCount);
			if (window.matchMedia('(min-width: 640px)').matches) return Math.min(2, uniqueCount);
			return 1;
		};

		const stepPercent = () => 100 / visibleCount();

		const render = (animate = true) => {
			track.style.transition = animate ? '' : 'none';
			track.style.transform = `translateX(-${index * stepPercent()}%)`;
			if (!animate) {
				// Force reflow so the next animated move works.
				void track.offsetWidth;
				track.style.transition = '';
			}
		};

		const go = (direction: number) => {
			if (locked) return;
			locked = true;
			index += direction;
			render(true);

			window.setTimeout(() => {
				if (index >= uniqueCount) {
					index -= uniqueCount;
					render(false);
				} else if (index < 0) {
					index += uniqueCount;
					render(false);
				}
				locked = false;
			}, 520);
		};

		root.querySelector('[data-testimonial-prev]')?.addEventListener('click', () => go(-1));
		root.querySelector('[data-testimonial-next]')?.addEventListener('click', () => go(1));

		window.addEventListener(
			'resize',
			() => {
				index = ((index % uniqueCount) + uniqueCount) % uniqueCount;
				render(false);
			},
			{ passive: true },
		);

		render(false);
	}

	function initLanding() {
		initOffer();
		initTestimonials();
	}

	initLanding();
	document.addEventListener('astro:page-load', initLanding);
</script>
