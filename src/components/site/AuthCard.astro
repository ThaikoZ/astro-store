---
interface Props {
	title: string;
	titleId?: string;
	subtitle?: string;
	class?: string;
}

const { title, titleId = 'auth-heading', subtitle, class: className } = Astro.props;
---

<div
	class:list={[
		'mx-auto w-full max-w-[28rem] animate-rise md:border md:border-border-soft md:bg-foam md:px-8 md:py-9 lg:px-10 lg:py-10',
		className,
	]}
>
	<header class="text-center">
		<p
			class="m-0 font-sans text-[0.62rem] font-medium tracking-[0.28em] text-ink/40 uppercase"
		>
			Konto
		</p>
		<h1
			id={titleId}
			class="mt-2.5 m-0 font-display text-[clamp(1.4rem,3vw,1.75rem)] font-normal tracking-[0.02em] text-ink"
		>
			{title}
		</h1>
		{
			subtitle && (
				<p class="mx-auto mt-2.5 m-0 max-w-sm font-sans text-[0.8125rem] leading-relaxed text-ink/55">
					{subtitle}
				</p>
			)
		}
		<div class="mx-auto mt-5 h-px w-10 bg-ink/15" aria-hidden="true"></div>
	</header>
	<div class="mt-7">
		<slot />
	</div>
</div>
