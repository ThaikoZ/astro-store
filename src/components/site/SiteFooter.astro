---
import { FOOTER_LINKS, IMAGES, SOCIAL } from '../../lib/site';

const year = new Date().getFullYear();
---

<footer class="border-t border-border-soft bg-foam text-ink">
	<div class="mx-auto max-w-6xl px-6 pt-16 pb-12 md:px-10 md:pt-20 md:pb-14">
		<div class="grid items-start gap-12 md:grid-cols-[1fr_auto_1fr] md:gap-10 lg:gap-16">
			<div class="order-2 mx-auto max-w-xs text-center md:order-1 md:mx-0 md:pt-4 md:text-left">
				<p
					class="m-0 font-sans text-[0.65rem] font-medium tracking-[0.28em] text-ink uppercase"
				>
					Klaudia Jaranowska
					<br />
					Sieradz | Łódź
				</p>
				<p
					class="mt-4 m-0 font-display text-[0.95rem] leading-relaxed text-ink/75 md:text-base md:leading-7"
				>
					Makijaż tworzony z pasją - specjalistka od naturalnego glow i kobiecej elegancji.
				</p>
			</div>

			<div class="order-1 flex justify-center md:order-2">
				<a
					href="/"
					class="inline-block transition-opacity hover:opacity-80"
					aria-label="Klaudia Jaranowska Makeup - strona główna"
				>
					<img
						class="h-32 w-auto md:h-40"
						src={IMAGES.footerLogo}
						alt="Klaudia Jaranowska Makeup"
						loading="lazy"
						width="150"
						height="200"
					/>
				</a>
			</div>

			<div class="order-3 flex justify-center md:justify-end md:pt-4">
				<div class="inline-flex flex-col items-center">
					<nav aria-label="Stopka">
						<ul
							class="m-0 flex list-none flex-col items-center gap-3 p-0 font-display text-[0.8rem] tracking-[0.18em] uppercase"
						>
							{
								FOOTER_LINKS.map((link) => (
									<li>
										<a
											class="text-ink no-underline transition-opacity hover:opacity-50"
											href={link.href}
										>
											{link.label}
										</a>
									</li>
								))
							}
							<li class="pt-1">
								<a
									href="/"
									class="font-sans text-[0.65rem] font-medium tracking-[0.22em] text-ink/70 no-underline uppercase transition-opacity hover:opacity-50"
								>
									Klaudia Jaranowska Makeup
								</a>
							</li>
						</ul>
					</nav>

					<ul
						class="mt-7 m-0 flex list-none items-center justify-center gap-3.5 p-0"
						aria-label="Social media"
					>
						<li>
							<a
								href={SOCIAL.instagram}
								class="flex size-10 items-center justify-center rounded-full border border-ink/80 bg-transparent text-ink transition-colors duration-200 hover:bg-ink hover:text-foam"
								rel="noopener noreferrer"
								target="_blank"
								aria-label="Instagram"
							>
								<svg
									class="size-[1.05rem]"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="1.5"
									aria-hidden="true"
								>
									<rect x="3" y="3" width="18" height="18" rx="5"></rect>
									<circle cx="12" cy="12" r="4"></circle>
									<circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"></circle>
								</svg>
							</a>
						</li>
						<li>
							<a
								href={SOCIAL.facebook}
								class="flex size-10 items-center justify-center rounded-full border border-ink/80 bg-transparent text-ink transition-colors duration-200 hover:bg-ink hover:text-foam"
								rel="noopener noreferrer"
								target="_blank"
								aria-label="Facebook"
							>
								<svg
									class="size-[1.15rem] -translate-y-px"
									viewBox="0 0 24 24"
									fill="currentColor"
									aria-hidden="true"
								>
									<path
										d="M13.5 22v-8h2.6l.4-3h-3V9.2c0-.9.3-1.5 1.6-1.5H16.7V5.1C16.3 5 15.4 4.9 14.3 4.9 11.7 4.9 10 6.5 10 9v2H7.5v3H10v8h3.5z"
									></path>
								</svg>
							</a>
						</li>
						<li>
							<a
								href={SOCIAL.tiktok}
								class="flex size-10 items-center justify-center rounded-full border border-ink/80 bg-transparent text-ink transition-colors duration-200 hover:bg-ink hover:text-foam"
								rel="noopener noreferrer"
								target="_blank"
								aria-label="TikTok"
							>
								<svg class="size-[1.05rem]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
									<path
										d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .55.04.81.1v-3.5a6.37 6.37 0 0 0-.81-.05A6.34 6.34 0 0 0 3.15 15.2a6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.34-6.34V8.77a8.19 8.19 0 0 0 4.76 1.52V6.84a4.84 4.84 0 0 1-1-.15z"
									></path>
								</svg>
							</a>
						</li>
					</ul>
				</div>
			</div>
		</div>
	</div>

	<div class="bg-ink px-6 py-3.5 md:px-10">
		<div
			class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-2.5 sm:flex-row"
		>
			<p class="m-0 font-sans text-[0.7rem] tracking-[0.08em] text-foam/90">
				© Copyright {year} Klaudia Jaranowska Make Up
			</p>
			<p class="m-0 font-sans text-[0.7rem] tracking-[0.06em] text-foam/70">
				Zaprojektowana przez
				<a
					href="https://truetoweb.com/"
					class="ml-1 font-medium text-foam no-underline transition-opacity hover:opacity-70"
					rel="noopener noreferrer"
					target="_blank"
				>
					TruetoWeb
				</a>
			</p>
		</div>
	</div>
</footer>
