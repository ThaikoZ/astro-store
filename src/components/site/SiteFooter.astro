---
import Container from '../ui/Container.astro';
import { FOOTER_LINKS, IMAGES, SOCIAL } from '../../lib/site';

const year = new Date().getFullYear();

const socialLinks = [
	{
		label: 'Instagram',
		href: SOCIAL.instagram,
		icon: 'instagram',
	},
	{
		label: 'Facebook',
		href: SOCIAL.facebook,
		icon: 'facebook',
	},
	{
		label: 'TikTok',
		href: SOCIAL.tiktok,
		icon: 'tiktok',
	},
] as const;
---

<footer class="border-t border-border-soft bg-foam text-ink">
	<Container class="flex flex-col items-center py-16 text-center md:py-20">
		<a
			href="/"
			class="inline-block transition-opacity hover:opacity-70"
			aria-label="Klaudia Jaranowska Makeup - strona główna"
		>
			<img
				class="h-24 w-auto md:h-28"
				src={IMAGES.footerLogo}
				alt="Klaudia Jaranowska Makeup"
				loading="lazy"
				width="150"
				height="200"
			/>
		</a>

		<p
			class="mt-8 m-0 font-display text-sm tracking-[0.22em] text-ink uppercase md:text-base"
		>
			Klaudia Jaranowska
		</p>
		<p
			class="mx-auto mt-4 m-0 max-w-md font-sans text-sm leading-relaxed text-ink/65 md:text-[0.95rem] md:leading-7"
		>
			Makijaż tworzony z pasją - specjalistka od naturalnego glow i kobiecej elegancji.
		</p>
		<p
			class="mt-5 m-0 font-sans text-[0.65rem] font-medium tracking-[0.24em] text-ink/50 uppercase"
		>
			Sieradz | Łódź
		</p>

		<nav class="mt-10" aria-label="Stopka">
			<ul
				class="m-0 flex list-none flex-wrap items-center justify-center gap-x-6 gap-y-3 p-0 font-display text-xs tracking-[0.16em] uppercase md:gap-x-8 md:text-sm"
			>
				{
					FOOTER_LINKS.map((link) => (
						<li>
							<a
								class="text-ink/80 no-underline transition-opacity hover:opacity-50"
								href={link.href}
							>
								{link.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>

		<ul
			class="mt-8 m-0 flex list-none items-center justify-center gap-5 p-0"
			aria-label="Social media"
		>
			{
				socialLinks.map((item) => (
					<li>
						<a
							href={item.href}
							class="flex size-9 items-center justify-center text-ink/70 transition-opacity hover:opacity-100 hover:text-ink"
							rel="noopener noreferrer"
							target="_blank"
							aria-label={item.label}
						>
							{item.icon === 'instagram' && (
								<svg
									class="size-[1.15rem]"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="1.4"
									aria-hidden="true"
								>
									<rect x="3" y="3" width="18" height="18" rx="5"></rect>
									<circle cx="12" cy="12" r="4"></circle>
									<circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"></circle>
								</svg>
							)}
							{item.icon === 'facebook' && (
								<svg
									class="size-[1.2rem] -translate-y-px"
									viewBox="0 0 24 24"
									fill="currentColor"
									aria-hidden="true"
								>
									<path d="M13.5 22v-8h2.6l.4-3h-3V9.2c0-.9.3-1.5 1.6-1.5H16.7V5.1C16.3 5 15.4 4.9 14.3 4.9 11.7 4.9 10 6.5 10 9v2H7.5v3H10v8h3.5z"></path>
								</svg>
							)}
							{item.icon === 'tiktok' && (
								<svg class="size-[1.15rem]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
									<path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .55.04.81.1v-3.5a6.37 6.37 0 0 0-.81-.05A6.34 6.34 0 0 0 3.15 15.2a6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.34-6.34V8.77a8.19 8.19 0 0 0 4.76 1.52V6.84a4.84 4.84 0 0 1-1-.15z"></path>
								</svg>
							)}
						</a>
					</li>
				))
			}
		</ul>
	</Container>

	<div class="border-t border-border-soft">
		<Container
			class="flex flex-col items-center justify-between gap-3 py-5 text-center sm:flex-row sm:gap-6 sm:text-left md:py-6"
		>
			<p class="m-0 font-sans text-[0.7rem] tracking-[0.06em] text-ink/50">
				© {year} Klaudia Jaranowska Make Up
			</p>
			<p class="m-0 font-sans text-[0.7rem] tracking-[0.04em] text-ink/40">
				Zaprojektowana przez{' '}
				<a
					href="https://truetoweb.com/"
					class="font-medium text-ink/60 no-underline transition-colors hover:text-ink"
					rel="noopener noreferrer"
					target="_blank"
				>
					TruetoWeb
				</a>
			</p>
		</Container>
	</div>
</footer>
