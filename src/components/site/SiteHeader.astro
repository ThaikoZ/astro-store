---
import CartDrawer from '../shop/CartDrawer.astro';
import Container from '../ui/Container.astro';
import { IMAGES, PRIMARY_NAV, type NavItem } from '../../lib/site';

interface Props {
	/** Transparent over hero photo; solid black on inner pages. */
	variant?: 'overlay' | 'solid';
}

const { variant = 'overlay' } = Astro.props;
const isOverlay = variant === 'overlay';

const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';

function normalizePath(href: string) {
	return href.replace(/\/+$/, '') || '/';
}

function isActiveHref(href: string) {
	return currentPath === normalizePath(href);
}

function isNavItemActive(item: NavItem) {
	if (item.children?.length) {
		return item.children.some((child) => isActiveHref(child.href));
	}
	return isActiveHref(item.href);
}
---

<header
	class:list={[
		'site-header fixed inset-x-0 top-0 z-30 w-full transition-[transform,background-color] duration-300 ease-out motion-reduce:transition-none',
		isOverlay ? 'bg-transparent' : 'bg-ink',
	]}
	data-site-header
	data-variant={variant}
>
	<Container class="relative z-50 flex items-center justify-between gap-6 py-5 md:py-6">
		<a href="/" class="shrink-0 text-foam no-underline" aria-label="Klaudia Jaranowska Makeup - strona główna">
			<img
				src={IMAGES.headerLogo}
				alt="Klaudia Jaranowska Make Up Artist"
				class="h-5 w-auto md:h-12 lg:h-7 xl:h-9"
				width="220"
				height="48"
				fetchpriority="high"
			/>
		</a>

		<nav class="hidden lg:block" aria-label="Główne">
			<ul class="m-0 flex list-none items-center gap-8 p-0">
				{
					PRIMARY_NAV.map((item) => {
						const active = isNavItemActive(item);
						return (
							<li class="relative group">
								{item.children ? (
									<>
										<span
											class:list={[
												'nav-link nav-link--static inline-flex items-center gap-1.5 whitespace-nowrap font-display text-sm tracking-[0.14em] text-foam uppercase',
												active && 'is-active',
											]}
											aria-current={active ? 'true' : undefined}
										>
											{item.label}
											<svg
												class="size-2.5 shrink-0 opacity-90 transition-transform duration-200 group-hover:rotate-180 group-focus-within:rotate-180 motion-reduce:transition-none"
												viewBox="0 0 12 8"
												fill="none"
												aria-hidden="true"
											>
												<path
													d="M1 1.5L6 6.5L11 1.5"
													stroke="currentColor"
													stroke-width="1.4"
													stroke-linecap="round"
													stroke-linejoin="round"
												/>
											</svg>
										</span>
										<ul class="invisible absolute left-1/2 top-full z-40 m-0 min-w-[14rem] -translate-x-1/2 list-none bg-ink p-3 opacity-0 shadow-lg transition group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
											{item.children.map((child) => {
												const childActive = isActiveHref(child.href);
												return (
													<li>
														<a
															href={child.href}
															class:list={[
																'nav-link block whitespace-nowrap px-3 py-2 font-display text-sm tracking-[0.12em] text-foam no-underline uppercase',
																childActive && 'is-active',
															]}
															aria-current={childActive ? 'page' : undefined}
														>
															{child.label}
														</a>
													</li>
												);
											})}
										</ul>
									</>
								) : (
									<a
										href={item.href}
										class:list={[
											'nav-link inline-block whitespace-nowrap font-display text-sm tracking-[0.14em] text-foam no-underline uppercase',
											active && 'is-active',
										]}
										aria-current={active ? 'page' : undefined}
									>
										{item.label}
									</a>
								)}
							</li>
						);
					})
				}
			</ul>
		</nav>

		<div class="flex items-center gap-3 md:gap-4">
			<div class="flex items-center gap-0">
				<a
					href="/logowanie/"
					class="flex size-9 items-center justify-center text-foam no-underline transition-opacity hover:opacity-70"
					aria-label="Zaloguj się"
					data-auth-account-link
				>
					<svg
						class="size-5"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="1.5"
						aria-hidden="true"
					>
						<circle cx="12" cy="8" r="3.5"></circle>
						<path d="M5.5 19.5c1.6-3.2 4-4.8 6.5-4.8s4.9 1.6 6.5 4.8" stroke-linecap="round"></path>
					</svg>
				</a>

				<button
					type="button"
					class="relative flex size-9 cursor-pointer items-center justify-center border-0 bg-transparent p-0 text-foam transition-opacity hover:opacity-70"
					aria-label="Otwórz koszyk"
					aria-controls="site-cart-drawer"
					data-cart-open
				>
					<svg
						class="size-5"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="1.5"
						aria-hidden="true"
					>
						<path
							d="M6.5 8h11l-1 11h-9l-1-11Z"
							stroke-linejoin="round"
						></path>
						<path d="M9 8V6.5a3 3 0 0 1 6 0V8" stroke-linecap="round"></path>
					</svg>
					<span
						class="absolute top-0.5 right-0.5 inline-flex min-w-4 items-center justify-center rounded-full bg-foam px-1 font-sans text-[0.625rem] leading-4 font-semibold text-ink tabular-nums"
						data-cart-count
						hidden
					>0</span>
				</button>
			</div>

			<button
				type="button"
				class="site-menu-toggle relative z-50 flex h-8 w-8 cursor-pointer items-center justify-center border-0 bg-transparent p-0 lg:hidden"
				aria-expanded="false"
				aria-controls="site-mobile-nav"
				aria-label="Otwórz menu"
				data-site-menu-toggle
			>
				<span class="sr-only">Menu</span>
				<span class="relative block h-3.5 w-7" aria-hidden="true">
					<span
						class="site-menu-bar absolute left-0 top-0 block h-px w-7 origin-center bg-foam transition-transform duration-300 ease-out"
						data-menu-bar="top"
					></span>
					<span
						class="site-menu-bar absolute left-0 top-1/2 block h-px w-7 -translate-y-1/2 bg-foam transition-opacity duration-200 ease-out"
						data-menu-bar="mid"
					></span>
					<span
						class="site-menu-bar absolute bottom-0 left-0 block h-px w-7 origin-center bg-foam transition-transform duration-300 ease-out"
						data-menu-bar="bottom"
					></span>
				</span>
			</button>
		</div>
	</Container>

	<div
		id="site-mobile-nav"
		class="site-mobile-nav pointer-events-none fixed inset-0 z-40 bg-ink/95 text-foam opacity-0 backdrop-blur-sm transition-[opacity,visibility] duration-300 ease-out invisible motion-reduce:transition-none"
		data-site-mobile-nav
		aria-hidden="true"
	>
		<div
			class="site-mobile-nav-inner flex h-full flex-col px-8 pb-10 pt-28 translate-y-3 opacity-0 transition-[opacity,transform] duration-300 ease-out delay-75 motion-reduce:translate-y-0 motion-reduce:transition-none md:pt-32"
			data-site-mobile-nav-inner
		>
			<nav aria-label="Menu mobilne">
				<ul class="m-0 flex list-none flex-col gap-5 p-0">
					{
						PRIMARY_NAV.map((item) => {
							const active = isNavItemActive(item);
							return (
								<li>
									{item.children ? (
										<div class="flex flex-col gap-3">
											<span
												class:list={[
													'nav-link nav-link--static inline-flex items-center gap-2 whitespace-nowrap font-display text-lg tracking-[0.14em] uppercase',
													active && 'is-active',
												]}
												aria-current={active ? 'true' : undefined}
											>
												{item.label}
												<svg
													class="size-3 shrink-0 opacity-90"
													viewBox="0 0 12 8"
													fill="none"
													aria-hidden="true"
												>
													<path
														d="M1 1.5L6 6.5L11 1.5"
														stroke="currentColor"
														stroke-width="1.4"
														stroke-linecap="round"
														stroke-linejoin="round"
													/>
												</svg>
											</span>
											<ul class="m-0 flex list-none flex-col gap-2 border-l border-foam/25 pl-4">
												{item.children.map((child) => {
													const childActive = isActiveHref(child.href);
													return (
														<li>
															<a
																href={child.href}
																class:list={[
																	'nav-link inline-block whitespace-nowrap font-display text-base tracking-[0.12em] text-foam no-underline uppercase opacity-90 transition-opacity hover:opacity-100',
																	childActive && 'is-active',
																]}
																aria-current={childActive ? 'page' : undefined}
																data-site-menu-link
															>
																{child.label}
															</a>
														</li>
													);
												})}
											</ul>
										</div>
									) : (
										<a
											href={item.href}
											class:list={[
												'nav-link inline-block whitespace-nowrap font-display text-lg tracking-[0.14em] text-foam no-underline uppercase',
												active && 'is-active',
											]}
											aria-current={active ? 'page' : undefined}
											data-site-menu-link
										>
											{item.label}
										</a>
									)}
								</li>
							);
						})
					}
					<li class="pt-2">
						<a
							href="/logowanie/"
							class="nav-link inline-flex items-center gap-2 whitespace-nowrap font-display text-lg tracking-[0.14em] text-foam no-underline uppercase"
							data-site-menu-link
							data-auth-account-link
							aria-label="Zaloguj się"
						>
							<svg
								class="size-5"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="1.5"
								aria-hidden="true"
							>
								<circle cx="12" cy="8" r="3.5"></circle>
								<path d="M5.5 19.5c1.6-3.2 4-4.8 6.5-4.8s4.9 1.6 6.5 4.8" stroke-linecap="round"></path>
							</svg>
							Konto
						</a>
					</li>
				</ul>
			</nav>
		</div>
	</div>
</header>

<CartDrawer />

<script>
	import '../../scripts/cart-ui';
</script>

<style>
	.nav-link {
		position: relative;
	}

	.nav-link::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: -0.2em;
		height: 1px;
		background-color: currentColor;
		opacity: 0;
		transition: opacity 280ms ease;
	}

	.nav-link.block::after {
		left: 0.75rem;
		right: 0.75rem;
		bottom: 0.45rem;
	}

	.nav-link:hover::after,
	.nav-link:focus-visible::after,
	.nav-link.is-active::after,
	.group:hover > .nav-link--static::after,
	.group:focus-within > .nav-link--static::after {
		opacity: 1;
	}

	@media (prefers-reduced-motion: reduce) {
		.nav-link::after {
			transition: none;
		}
	}

	.site-header.is-hidden {
		transform: translateY(-100%);
	}

	.site-header.is-scrolled {
		background-color: #000000;
	}

	header:has([data-site-menu-toggle][aria-expanded='true']) .site-mobile-nav {
		pointer-events: auto;
		visibility: visible;
		opacity: 1;
	}

	header:has([data-site-menu-toggle][aria-expanded='true']) .site-mobile-nav-inner {
		transform: translateY(0);
		opacity: 1;
	}

	header:has([data-site-menu-toggle][aria-expanded='true']) [data-menu-bar='top'] {
		transform: translateY(6.5px) rotate(45deg);
	}

	header:has([data-site-menu-toggle][aria-expanded='true']) [data-menu-bar='mid'] {
		opacity: 0;
	}

	header:has([data-site-menu-toggle][aria-expanded='true']) [data-menu-bar='bottom'] {
		transform: translateY(-6.5px) rotate(-45deg);
	}

	@media (prefers-reduced-motion: reduce) {
		.site-header.is-hidden {
			transform: none;
		}

		header:has([data-site-menu-toggle][aria-expanded='true']) .site-mobile-nav-inner {
			transform: none;
		}

		header:has([data-site-menu-toggle][aria-expanded='true']) [data-menu-bar='top'],
		header:has([data-site-menu-toggle][aria-expanded='true']) [data-menu-bar='bottom'] {
			transform: none;
		}
	}
</style>

<script>
	function hasAuthCookie() {
		const cookie = document.cookie;
		return cookie.includes('auth-token=') || cookie.includes('auth-refresh-token=');
	}

	function syncAuthAccountLinks() {
		const loggedIn = hasAuthCookie();
		const href = loggedIn ? '/moje-konto/' : '/logowanie/';
		const label = loggedIn ? 'Moje konto' : 'Zaloguj się';

		document.querySelectorAll('[data-auth-account-link]').forEach((link) => {
			if (!(link instanceof HTMLAnchorElement)) return;
			link.href = href;
			link.setAttribute('aria-label', label);
		});
	}

	function initSiteHeader() {
		const header = document.querySelector('[data-site-header]');
		const toggle = document.querySelector('[data-site-menu-toggle]');
		const panel = document.querySelector('[data-site-mobile-nav]');
		if (!(header instanceof HTMLElement) || !(toggle instanceof HTMLElement) || !(panel instanceof HTMLElement)) {
			return;
		}

		syncAuthAccountLinks();

		if (header.dataset.headerBound === 'true') return;
		header.dataset.headerBound = 'true';

		const setMenuOpen = (open: boolean) => {
			toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
			toggle.setAttribute('aria-label', open ? 'Zamknij menu' : 'Otwórz menu');
			panel.setAttribute('aria-hidden', open ? 'false' : 'true');
			document.documentElement.classList.toggle('overflow-hidden', open);
			if (open) header.classList.remove('is-hidden');
		};

		toggle.addEventListener('click', () => {
			setMenuOpen(toggle.getAttribute('aria-expanded') !== 'true');
		});
		panel.querySelectorAll('[data-site-menu-link]').forEach((link) => {
			link.addEventListener('click', () => setMenuOpen(false));
		});
		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape') setMenuOpen(false);
		});

		let lastY = window.scrollY;
		let ticking = false;
		const topThreshold = 24;
		const deltaThreshold = 6;
		const isOverlay = header.dataset.variant === 'overlay';

		const updateHeader = () => {
			const y = window.scrollY;
			const delta = y - lastY;
			const menuOpen = toggle.getAttribute('aria-expanded') === 'true';

			if (isOverlay) {
				header.classList.toggle('is-scrolled', y > topThreshold);
			}

			if (!menuOpen) {
				if (y <= topThreshold) {
					header.classList.remove('is-hidden');
				} else if (delta > deltaThreshold) {
					header.classList.add('is-hidden');
				} else if (delta < -deltaThreshold) {
					header.classList.remove('is-hidden');
				}
			}

			lastY = y;
			ticking = false;
		};

		window.addEventListener(
			'scroll',
			() => {
				if (ticking) return;
				ticking = true;
				window.requestAnimationFrame(updateHeader);
			},
			{ passive: true },
		);

		updateHeader();
	}

	initSiteHeader();
	document.addEventListener('astro:page-load', initSiteHeader);
</script>
