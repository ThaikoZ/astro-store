---
import Button from '../ui/Button.astro';

interface Props {
	title: string;
	subtitle: string;
	price: string;
	duration: string;
	image: string;
	scope: readonly string[];
	notes: readonly string[];
	ctaHref?: string;
	ctaLabel?: string;
}

const {
	title,
	subtitle,
	price,
	duration,
	image,
	scope,
	notes,
	ctaHref = '/kontakt/',
	ctaLabel = 'Zapisz się',
} = Astro.props;

const headingId = `lekcja-${title.toLowerCase().replace(/\s+/g, '-')}`;
const scopeTriggerId = `${headingId}-scope-trigger`;
const scopePanelId = `${headingId}-scope-panel`;
const notesTriggerId = `${headingId}-notes-trigger`;
const notesPanelId = `${headingId}-notes-panel`;
---

<article class="flex h-full flex-col" aria-labelledby={headingId}>
	<div class="relative">
		<div class="aspect-4/5 overflow-hidden rounded-t-[2.5rem]">
			<img
				src={image}
				alt={title}
				class="size-full object-cover object-[center_28%]"
				loading="lazy"
				decoding="async"
			/>
		</div>

		<div
			class="relative z-10 mx-4 -mt-14 flex items-stretch gap-4 rounded-2xl bg-foam px-5 py-5 shadow-sm md:mx-6 md:px-6"
		>
			<div class="min-w-0 flex-1">
				<h2
					id={headingId}
					class="m-0 font-display text-[clamp(1.05rem,2vw,1.25rem)] font-normal tracking-[0.1em] text-ink uppercase"
				>
					{title}
				</h2>
				<p class="mt-1 m-0 font-sans text-xs tracking-wide text-ink/70 md:text-sm">
					{subtitle}
				</p>
				<p class="mt-3 m-0 font-display text-[clamp(1.5rem,3vw,1.85rem)] font-normal tracking-[0.04em] text-ink">
					{price}
				</p>
			</div>

			<div
				class="flex shrink-0 flex-col items-center justify-center gap-2 border-l border-ink/15 pl-4 md:pl-5"
			>
				<svg
					class="size-6 text-ink"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.4"
					aria-hidden="true"
				>
					<circle cx="12" cy="12" r="8.5"></circle>
					<path d="M12 7.5V12l3 2" stroke-linecap="round" stroke-linejoin="round"></path>
				</svg>
				<span class="font-sans text-sm tracking-wide text-ink md:text-base">{duration}</span>
			</div>
		</div>
	</div>

	<div class="mt-8 flex flex-1 flex-col border-t border-ink" data-accordion>
		<div class="border-b border-ink" data-accordion-item>
			<button
				type="button"
				id={scopeTriggerId}
				class="flex w-full cursor-pointer items-center justify-between gap-4 border-0 bg-transparent py-4 text-left font-sans text-xs tracking-[0.16em] text-ink uppercase md:text-sm"
				aria-expanded="false"
				aria-controls={scopePanelId}
				data-accordion-trigger
			>
				Zakres szkolenia
				<span class="relative inline-block size-4 shrink-0 text-lg leading-none" aria-hidden="true">
					<span class="accordion-icon-plus absolute inset-0 flex items-center justify-center">+</span>
					<span class="accordion-icon-minus absolute inset-0 flex items-center justify-center opacity-0"
						>−</span
					>
				</span>
			</button>
			<div
				id={scopePanelId}
				class="accordion-panel grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-out motion-reduce:transition-none"
				role="region"
				aria-labelledby={scopeTriggerId}
				data-accordion-panel
			>
				<div class="overflow-hidden">
					<ul
						class="m-0 list-none space-y-2 pb-5 pl-0 font-sans text-sm leading-relaxed text-ink/80 md:text-[0.95rem] md:leading-7"
					>
						{scope.map((item) => <li>• {item}</li>)}
					</ul>
				</div>
			</div>
		</div>

		<div class="border-b border-ink" data-accordion-item>
			<button
				type="button"
				id={notesTriggerId}
				class="flex w-full cursor-pointer items-center justify-between gap-4 border-0 bg-transparent py-4 text-left font-sans text-xs tracking-[0.16em] text-ink uppercase md:text-sm"
				aria-expanded="false"
				aria-controls={notesPanelId}
				data-accordion-trigger
			>
				Ważne informacje
				<span class="relative inline-block size-4 shrink-0 text-lg leading-none" aria-hidden="true">
					<span class="accordion-icon-plus absolute inset-0 flex items-center justify-center">+</span>
					<span class="accordion-icon-minus absolute inset-0 flex items-center justify-center opacity-0"
						>−</span
					>
				</span>
			</button>
			<div
				id={notesPanelId}
				class="accordion-panel grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-out motion-reduce:transition-none"
				role="region"
				aria-labelledby={notesTriggerId}
				data-accordion-panel
			>
				<div class="overflow-hidden">
					<ul
						class="m-0 list-none space-y-2 pb-5 pl-0 font-sans text-sm leading-relaxed text-ink/80 md:text-[0.95rem] md:leading-7"
					>
						{notes.map((item) => <li>• {item}</li>)}
					</ul>
				</div>
			</div>
		</div>

		<div class="mt-auto pt-8">
			<Button href={ctaHref} variant="solid" tone="ink" class="w-full">
				{ctaLabel}
			</Button>
		</div>
	</div>
</article>

<style>
	.accordion-panel.is-open {
		grid-template-rows: 1fr;
	}

	button[aria-expanded='true'] .accordion-icon-plus {
		opacity: 0;
	}

	button[aria-expanded='true'] .accordion-icon-minus {
		opacity: 1;
	}

	.accordion-icon-plus,
	.accordion-icon-minus {
		transition: opacity 200ms ease;
	}

	@media (prefers-reduced-motion: reduce) {
		.accordion-icon-plus,
		.accordion-icon-minus {
			transition: none;
		}
	}
</style>

<script>
	function setAccordionOpen(
		trigger: HTMLButtonElement,
		panel: HTMLElement,
		open: boolean,
	) {
		trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
		panel.classList.toggle('is-open', open);
	}

	function initLessonAccordions() {
		document.querySelectorAll('[data-accordion]').forEach((root) => {
			if (!(root instanceof HTMLElement)) return;
			if (root.dataset.accordionBound === 'true') return;
			root.dataset.accordionBound = 'true';

			const items = [...root.querySelectorAll('[data-accordion-item]')];

			items.forEach((item) => {
				const trigger = item.querySelector('[data-accordion-trigger]');
				const panel = item.querySelector('[data-accordion-panel]');
				if (!(trigger instanceof HTMLButtonElement) || !(panel instanceof HTMLElement)) return;

				trigger.addEventListener('click', () => {
					const willOpen = trigger.getAttribute('aria-expanded') !== 'true';

					items.forEach((other) => {
						const otherTrigger = other.querySelector('[data-accordion-trigger]');
						const otherPanel = other.querySelector('[data-accordion-panel]');
						if (
							!(otherTrigger instanceof HTMLButtonElement) ||
							!(otherPanel instanceof HTMLElement)
						) {
							return;
						}
						setAccordionOpen(otherTrigger, otherPanel, false);
					});

					if (willOpen) {
						setAccordionOpen(trigger, panel, true);
					}
				});
			});
		});
	}

	initLessonAccordions();
	document.addEventListener('astro:page-load', initLessonAccordions);
</script>
