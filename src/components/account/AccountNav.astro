---
const primary = [
	{ id: 'kokpit', label: 'Kokpit', icon: 'gauge' },
	{ id: 'profil', label: 'Mój profil', icon: 'user' },
	{ id: 'kursy', label: 'Kursy', icon: 'grad' },
	{ id: 'zamowienia', label: 'Historia zamówień', icon: 'cart' },
] as const;

const secondary = [
	{ id: 'ustawienia', label: 'Ustawienia', icon: 'gear' },
] as const;

const iconPaths: Record<string, string> = {
	gauge:
		'M12 3a9 9 0 0 0-9 9v1h2v-1a7 7 0 0 1 14 0v1h2v-1a9 9 0 0 0-9-9Zm-1 9.5 3.2-4.2 1.6 1.2-4.8 6.3H9v-3.3Z',
	user: 'M12 12a4 4 0 1 0-4-4 4 4 0 0 0 4 4Zm0 2c-4 0-7 2-7 4.5V20h14v-1.5C19 16 16 14 12 14Z',
	grad: 'M12 4 2 9l10 5 8-4.1V17h2V9L12 4Zm-6 8.2V15c0 1.7 2.7 3 6 3s6-1.3 6-3v-2.8l-6 3-6-3Z',
	cart: 'M7 6h14l-1.5 8H8.2L7 6Zm0 0L5.5 3H2v2h2.2L7.8 17H19v-2H9.2l-.4-2H18L20.5 4H7v2Zm-1 14a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3Zm11 0a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3Z',
	gear: 'M11 2h2l.4 2.2a6.8 6.8 0 0 1 1.7.7l2-1.1 1.4 1.4-1.1 2a6.8 6.8 0 0 1 .7 1.7L22 11v2l-2.2.4a6.8 6.8 0 0 1-.7 1.7l1.1 2-1.4 1.4-2-1.1a6.8 6.8 0 0 1-1.7.7L13 22h-2l-.4-2.2a6.8 6.8 0 0 1-1.7-.7l-2 1.1-1.4-1.4 1.1-2a6.8 6.8 0 0 1-.7-1.7L2 13v-2l2.2-.4a6.8 6.8 0 0 1 .7-1.7l-1.1-2L5.2 5.5l2 1.1a6.8 6.8 0 0 1 1.7-.7L11 2Zm1 6a4 4 0 1 0 0 8 4 4 0 0 0 0-8Z',
	logout:
		'M10 4H5a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h5v-2H5V6h5V4Zm4.6 4.6 4.4 3.4-4.4 3.4v-2.4H9v-2h5.6V8.6Z',
};

const linkClass =
	'flex w-full cursor-pointer items-center gap-3 border-0 bg-transparent px-3 py-2.5 text-left font-sans text-sm text-ink no-underline transition-colors hover:bg-paper aria-[current=page]:bg-ink aria-[current=page]:text-foam';
---

<nav class="w-full" aria-label="Konto" data-account-nav>
	<ul class="m-0 flex list-none flex-col gap-1 p-0">
		{
			primary.map((item) => (
				<li>
					<a
						href={`/moje-konto/?tab=${item.id}`}
						class={linkClass}
						data-account-tab={item.id}
						aria-current={item.id === 'kokpit' ? 'page' : undefined}
					>
						<svg class="size-4 shrink-0 fill-current" viewBox="0 0 24 24" aria-hidden="true">
							<path d={iconPaths[item.icon]} />
						</svg>
						<span>{item.label}</span>
					</a>
				</li>
			))
		}
	</ul>

	<div class="my-4 h-px bg-border-soft" aria-hidden="true"></div>

	<ul class="m-0 flex list-none flex-col gap-1 p-0">
		{
			secondary.map((item) => (
				<li>
					<a
						href={`/moje-konto/?tab=${item.id}`}
						class={linkClass}
						data-account-tab={item.id}
					>
						<svg class="size-4 shrink-0 fill-current" viewBox="0 0 24 24" aria-hidden="true">
							<path d={iconPaths[item.icon]} />
						</svg>
						<span>{item.label}</span>
					</a>
				</li>
			))
		}
		<li>
			<button type="button" class={linkClass} data-account-logout>
				<svg class="size-4 shrink-0 fill-current" viewBox="0 0 24 24" aria-hidden="true">
					<path d={iconPaths.logout} />
				</svg>
				<span>Wyloguj się</span>
			</button>
		</li>
	</ul>
</nav>
