---
const orderSkeletons = [1, 2, 3];

const presets = [
	{ id: 'all', label: 'Wszystkie' },
	{ id: 'today', label: 'Dziś' },
	{ id: 'month', label: 'Ostatni miesiąc' },
	{ id: 'year', label: 'Ten rok' },
	{ id: 'range', label: 'Zakres' },
] as const;
---

<section data-account-panel="zamowienia" class="hidden" aria-hidden="true">
	<h2
		class="mt-0 mb-8 font-display text-[clamp(1.6rem,3vw,2.15rem)] font-normal tracking-[0.02em] text-ink md:mb-10"
	>
		Historia zamówień
	</h2>

	<div class="mb-6 space-y-4" data-account-orders-filters>
		<div class="flex flex-wrap gap-2" role="group" aria-label="Filtruj zamówienia">
			{
				presets.map((preset) => (
					<button
						type="button"
						class="cursor-pointer border border-border-soft bg-foam px-3.5 py-2 font-sans text-xs tracking-[0.12em] text-ink uppercase transition-colors hover:border-ink aria-[pressed=true]:border-ink aria-[pressed=true]:bg-ink aria-[pressed=true]:text-foam"
						data-orders-filter={preset.id}
						aria-pressed={preset.id === 'all' ? 'true' : 'false'}
					>
						{preset.label}
					</button>
				))
			}
		</div>

		<div
			class="hidden flex-wrap items-end gap-3 border border-border-soft bg-foam p-4"
			data-orders-range
			hidden
		>
			<label class="block min-w-[9rem] flex-1">
				<span class="mb-1 block font-sans text-[0.65rem] font-medium tracking-[0.14em] text-ink/50 uppercase">
					Od
				</span>
				<input
					type="date"
					name="ordersFrom"
					data-orders-from
					class="w-full border-0 border-b border-ink/20 bg-transparent py-2 font-sans text-sm text-ink outline-none focus:border-ink"
				/>
			</label>
			<label class="block min-w-[9rem] flex-1">
				<span class="mb-1 block font-sans text-[0.65rem] font-medium tracking-[0.14em] text-ink/50 uppercase">
					Do
				</span>
				<input
					type="date"
					name="ordersTo"
					data-orders-to
					class="w-full border-0 border-b border-ink/20 bg-transparent py-2 font-sans text-sm text-ink outline-none focus:border-ink"
				/>
			</label>
			<button
				type="button"
				class="cursor-pointer border border-ink bg-ink px-4 py-2.5 font-sans text-xs tracking-[0.14em] text-foam uppercase transition-opacity hover:opacity-80"
				data-orders-range-apply
			>
				Zastosuj
			</button>
		</div>
	</div>

	<p class="m-0 hidden font-sans text-sm leading-relaxed" data-account-status="orders" hidden></p>
	<div class="space-y-3" data-account-orders data-loading>
		<div class="space-y-3" data-account-orders-skeleton aria-hidden="true">
			{
				orderSkeletons.map(() => (
					<div class="border border-border-soft bg-foam px-4 py-5 md:px-5">
						<div class="flex items-center justify-between gap-3">
							<span class="skeleton h-4 w-36"></span>
							<span class="skeleton h-4 w-20"></span>
						</div>
						<div class="mt-3 flex gap-4">
							<span class="skeleton h-3 w-24"></span>
							<span class="skeleton h-3 w-20"></span>
							<span class="skeleton h-3 w-28"></span>
						</div>
					</div>
				))
			}
		</div>
		<div class="space-y-3" data-account-orders-loaded></div>
	</div>
</section>
