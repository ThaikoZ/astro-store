---
interface Props {
	panel: string;
	title: string;
}

const { panel, title } = Astro.props;
---

<section data-account-panel={panel} class="hidden" aria-hidden="true">
	<h2
		class="mt-0 mb-8 font-display text-[clamp(1.6rem,3vw,2.15rem)] font-normal tracking-[0.02em] text-ink md:mb-10"
	>
		{title}
	</h2>
	<div class="border border-border-soft bg-foam px-8 py-16 text-center md:px-12 md:py-20">
		<p class="mx-auto m-0 max-w-md font-sans text-sm leading-relaxed text-ink/55 md:text-[0.95rem]">
			Ta sekcja będzie dostępna po uruchomieniu platformy kursów.
		</p>
	</div>
</section>
