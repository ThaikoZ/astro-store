---
const stats = [
	{
		label: 'Kursy na które się zapisano',
		icon: 'M4 5h16v2H4V5Zm0 4h16v10H4V9Zm2 2v6h12v-6H6Z',
	},
	{
		label: 'Aktywne kursy',
		icon: 'M12 4 2 9l10 5 8-4.1V17h2V9L12 4Zm-6 8.2V15c0 1.7 2.7 3 6 3s6-1.3 6-3v-2.8l-6 3-6-3Z',
	},
	{
		label: 'Ukończone kursy',
		icon: 'M12 3 8 7.5h3v6h2v-6h3L12 3Zm-7 14h14v2H5v-2Z',
	},
] as const;
---

<section data-account-panel="kokpit" aria-hidden="false">
	<h2
		class="mt-0 mb-8 font-display text-[clamp(1.6rem,3vw,2.15rem)] font-normal tracking-[0.02em] text-ink md:mb-10"
	>
		Kokpit
	</h2>
	<div class="grid gap-5 sm:grid-cols-3 sm:gap-6">
		{
			stats.map((stat) => (
				<article class="flex min-h-[14rem] flex-col items-center justify-center border border-border-soft bg-foam px-5 py-10 text-center md:min-h-[16rem] md:py-12">
					<div class="flex size-16 items-center justify-center rounded-full bg-paper text-ink md:size-[4.5rem]">
						<svg class="size-7 fill-current md:size-8" viewBox="0 0 24 24" aria-hidden="true">
							<path d={stat.icon} />
						</svg>
					</div>
					<p class="mt-6 m-0 font-sans text-4xl font-medium tracking-tight text-ink md:text-5xl">
						0
					</p>
					<p class="mt-3 m-0 max-w-[12rem] font-sans text-sm leading-snug text-ink/55">
						{stat.label}
					</p>
				</article>
			))
		}
	</div>
</section>
