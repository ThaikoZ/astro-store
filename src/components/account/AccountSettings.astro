---
import Button from '../ui/Button.astro';
import AuthField from '../site/AuthField.astro';
---

<section data-account-panel="ustawienia" class="hidden" aria-hidden="true">
	<h2
		class="mt-0 mb-8 font-display text-[clamp(1.6rem,3vw,2.15rem)] font-normal tracking-[0.02em] text-ink md:mb-10"
	>
		Ustawienia
	</h2>
	<form class="max-w-md space-y-5" data-account-form="password" novalidate>
		<AuthField
			label="Nowe hasło"
			name="password"
			type="password"
			autocomplete="new-password"
			placeholder="Nowe hasło"
		/>
		<AuthField
			label="Powtórz hasło"
			name="passwordConfirm"
			type="password"
			autocomplete="new-password"
			placeholder="Powtórz hasło"
		/>

		<p class="m-0 hidden font-sans text-sm leading-relaxed" data-account-status="password" hidden></p>

		<Button type="submit" variant="solid" tone="ink" class="mt-2">
			Zmień hasło
		</Button>
	</form>
</section>
