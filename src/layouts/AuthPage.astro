---
import SiteFooter from '../components/site/SiteFooter.astro';
import SiteHeader from '../components/site/SiteHeader.astro';
import Container from '../components/ui/Container.astro';
import Layout from './Layout.astro';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<Layout title={title} withTopMargin>
	<div class="min-h-full bg-foam text-ink md:bg-paper">
		<SiteHeader variant="solid" />
		<main class="py-10 md:py-16">
			<Container>
				<slot />
			</Container>
		</main>
		<SiteFooter />
	</div>
</Layout>
