---
import SiteFooter from '../components/site/SiteFooter.astro';
import SiteHeader from '../components/site/SiteHeader.astro';
import Button from '../components/ui/Button.astro';
import Container from '../components/ui/Container.astro';
import Layout from '../layouts/Layout.astro';
import { CONTACT } from '../lib/site';

const mapEmbed = (query: string) =>
	`https://maps.google.com/maps?q=${encodeURIComponent(query)}&z=15&output=embed`;
---

<Layout title="Kontakt - Klaudia Jaranowska Makeup" withTopMargin>
	<div class="min-h-full bg-foam text-ink">
		<SiteHeader variant="solid" />

		<main>
			<section class="py-20 md:py-28" aria-labelledby="kontakt-heading">
				<Container class="grid items-start gap-14 lg:grid-cols-2 lg:gap-16 xl:gap-20">
					<div>
						<h1
							id="kontakt-heading"
							class="m-0 font-display text-[clamp(1.75rem,3.5vw,2.5rem)] font-normal tracking-[0.14em] text-ink uppercase"
						>
							Kontakt
						</h1>
						<p
							class="mt-6 m-0 max-w-lg font-sans text-sm leading-relaxed text-ink/80 md:text-[0.95rem] md:leading-7"
						>
							Chcesz umówić się na makijaż lub zapisać na szkolenie? Skontaktuj się ze mną
							wypełniając formularz poniżej - razem ustalimy termin i dopasujemy usługę do
							Twoich potrzeb.
						</p>

						<form class="mt-10 space-y-6" data-contact-form>
							<label class="block">
								<span class="sr-only">Imię i nazwisko</span>
								<input
									type="text"
									name="name"
									required
									autocomplete="name"
									placeholder="Imię i nazwisko"
									class="w-full border-0 border-b border-ink/30 bg-transparent px-0 py-3 font-sans text-sm text-ink outline-none transition-colors placeholder:text-ink/45 focus:border-ink"
								/>
							</label>
							<label class="block">
								<span class="sr-only">Adres e-mail</span>
								<input
									type="email"
									name="email"
									required
									autocomplete="email"
									placeholder="Adres e-mail"
									class="w-full border-0 border-b border-ink/30 bg-transparent px-0 py-3 font-sans text-sm text-ink outline-none transition-colors placeholder:text-ink/45 focus:border-ink"
								/>
							</label>
							<label class="block">
								<span class="sr-only">Numer telefonu</span>
								<input
									type="tel"
									name="phone"
									required
									autocomplete="tel"
									placeholder="Numer Telefonu"
									class="w-full border-0 border-b border-ink/30 bg-transparent px-0 py-3 font-sans text-sm text-ink outline-none transition-colors placeholder:text-ink/45 focus:border-ink"
								/>
							</label>
							<label class="block">
								<span class="sr-only">Wiadomość</span>
								<textarea
									name="message"
									required
									rows="7"
									placeholder="Tutaj wpisz treść swojego zapytania"
									class="mt-2 w-full resize-y border border-ink/30 bg-transparent px-4 py-3 font-sans text-sm text-ink outline-none transition-colors placeholder:text-ink/45 focus:border-ink"
								></textarea>
							</label>
							<Button type="submit" variant="solid" tone="ink" class="w-full">
								Wyślij
							</Button>
						</form>
					</div>

					<div>
						<h2
							id="dojazd-heading"
							class="m-0 font-display text-[clamp(1.5rem,3vw,2rem)] font-normal tracking-[0.04em] text-ink"
						>
							Jak dojechać?
						</h2>

						<div class="mt-8 border-t border-ink" data-accordion>
							{
								CONTACT.salons.map((salon, index) => {
									const open = index === 0;
									const triggerId = `map-trigger-${salon.id}`;
									const panelId = `map-panel-${salon.id}`;
									return (
										<div class="border-b border-ink" data-accordion-item>
											<button
												type="button"
												id={triggerId}
												class="flex w-full cursor-pointer items-center justify-between gap-4 border-0 bg-transparent py-4 text-left font-sans text-xs tracking-[0.16em] text-ink uppercase md:text-sm"
												aria-expanded={open ? 'true' : 'false'}
												aria-controls={panelId}
												data-accordion-trigger
											>
												{salon.label}
												<span
													class="relative inline-block size-4 shrink-0 text-lg leading-none"
													aria-hidden="true"
												>
													<span class="accordion-icon-plus absolute inset-0 flex items-center justify-center">
														+
													</span>
													<span class="accordion-icon-minus absolute inset-0 flex items-center justify-center opacity-0">
														−
													</span>
												</span>
											</button>
											<div
												id={panelId}
												class:list={[
													'accordion-panel grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-out motion-reduce:transition-none',
													open && 'is-open',
												]}
												role="region"
												aria-labelledby={triggerId}
												data-accordion-panel
											>
												<div class="overflow-hidden">
													<div class="pb-5">
														<iframe
															title={`Mapa - ${salon.label}`}
															src={mapEmbed(salon.mapQuery)}
															class="aspect-4/3 w-full border-0 bg-paper"
															loading="lazy"
															referrerpolicy="no-referrer-when-downgrade"
															allowfullscreen
														/>
													</div>
												</div>
											</div>
										</div>
									);
								})
							}
						</div>
					</div>
				</Container>
			</section>

			<section class="bg-paper py-16 md:py-20" aria-labelledby="dane-heading">
				<Container class="grid gap-12 md:grid-cols-2 md:gap-16">
					<div>
						<h2
							id="dane-heading"
							class="m-0 font-display text-[clamp(1.4rem,2.5vw,1.75rem)] font-normal tracking-[0.04em] text-ink"
						>
							Dane kontaktowe
						</h2>
						<div class="mt-6 space-y-3 font-sans text-sm leading-relaxed text-ink/80 md:text-[0.95rem] md:leading-7">
							<p class="m-0">{CONTACT.brand}</p>
							<p class="m-0">
								<a
									href={`mailto:${CONTACT.email}`}
									class="inline-flex items-center gap-2.5 text-ink no-underline transition-opacity hover:opacity-70"
								>
									<svg
										class="size-4 shrink-0"
										viewBox="0 0 24 24"
										fill="none"
										stroke="currentColor"
										stroke-width="1.5"
										aria-hidden="true"
									>
										<rect x="3" y="5" width="18" height="14" rx="2"></rect>
										<path d="M3 7l9 6 9-6" stroke-linecap="round" stroke-linejoin="round"></path>
									</svg>
									<span class="underline decoration-ink/40 underline-offset-4">{CONTACT.email}</span>
								</a>
							</p>
							<p class="m-0">
								<a
									href={CONTACT.phoneHref}
									class="inline-flex items-center gap-2.5 text-ink no-underline transition-opacity hover:opacity-70"
								>
									<svg
										class="size-4 shrink-0"
										viewBox="0 0 24 24"
										fill="none"
										stroke="currentColor"
										stroke-width="1.5"
										aria-hidden="true"
									>
										<path
											d="M6.5 4.5h3l1.5 4-2 1.5a12 12 0 0 0 5.5 5.5l1.5-2 4 1.5v3a2 2 0 0 1-2 2A15.5 15.5 0 0 1 4.5 6.5a2 2 0 0 1 2-2z"
											stroke-linejoin="round"
										></path>
									</svg>
									<span class="underline decoration-ink/40 underline-offset-4"
										>{CONTACT.phoneDisplay}</span
									>
								</a>
							</p>
						</div>
					</div>

					<div>
						<h2
							id="salony-heading"
							class="m-0 font-display text-[clamp(1.4rem,2.5vw,1.75rem)] font-normal tracking-[0.04em] text-ink"
						>
							Nasze salony
						</h2>
						<div class="mt-6 flex flex-col gap-1.5">
							{
								CONTACT.salons.map((salon) => (
									<div class="flex items-center gap-2.5 font-sans text-sm leading-relaxed text-ink/80 md:text-[0.95rem] md:leading-7">
										<svg
											class="size-4 shrink-0"
											viewBox="0 0 24 24"
											fill="none"
											stroke="currentColor"
											stroke-width="1.5"
											aria-hidden="true"
										>
											<path
												d="M12 21s7-5.5 7-11a7 7 0 1 0-14 0c0 5.5 7 11 7 11z"
												stroke-linejoin="round"
											></path>
											<circle cx="12" cy="10" r="2.5"></circle>
										</svg>
										<p class="m-0">
											{salon.line1}, {salon.line2}
										</p>
									</div>
								))
							}
						</div>
					</div>
				</Container>
			</section>
		</main>

		<SiteFooter />
	</div>
</Layout>

<script>
	import { initSiteAccordions } from '../scripts/site-accordion';
	import { CONTACT } from '../lib/site';

	initSiteAccordions();
	document.addEventListener('astro:page-load', initSiteAccordions);

	function initContactForm() {
		const form = document.querySelector('[data-contact-form]');
		if (!(form instanceof HTMLFormElement)) return;
		if (form.dataset.bound === 'true') return;
		form.dataset.bound = 'true';

		form.addEventListener('submit', (event) => {
			event.preventDefault();
			const data = new FormData(form);
			const name = String(data.get('name') ?? '').trim();
			const email = String(data.get('email') ?? '').trim();
			const phone = String(data.get('phone') ?? '').trim();
			const message = String(data.get('message') ?? '').trim();

			const subject = encodeURIComponent(`Wiadomość ze strony - ${name}`);
			const body = encodeURIComponent(
				`Imię i nazwisko: ${name}\nE-mail: ${email}\nTelefon: ${phone}\n\n${message}`,
			);
			window.location.href = `mailto:${CONTACT.email}?subject=${subject}&body=${body}`;
		});
	}

	initContactForm();
	document.addEventListener('astro:page-load', initContactForm);
</script>
