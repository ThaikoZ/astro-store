---
import LessonOfferCard from '../components/site/LessonOfferCard.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import SiteHeader from '../components/site/SiteHeader.astro';
import Container from '../components/ui/Container.astro';
import Layout from '../layouts/Layout.astro';
import { LEKCJA_MAKIJAZU } from '../lib/site';
---

<Layout title="Lekcja Makijażu - Klaudia Jaranowska Makeup" withTopMargin>
	<div class="min-h-full bg-paper text-ink">
		<SiteHeader variant="solid" />

		<main>
			<section class="py-20 md:py-28" aria-labelledby="lekcja-heading">
				<Container>
					<h1
						id="lekcja-heading"
						class="m-0 text-center font-display text-[clamp(1.75rem,3.5vw,2.5rem)] font-normal tracking-[0.14em] text-ink uppercase"
					>
						Lekcja makijażu
					</h1>

					<div class="mt-14 grid items-stretch gap-14 md:mt-16 md:grid-cols-2 md:gap-10 lg:gap-14">
						{
							LEKCJA_MAKIJAZU.map((lesson) => (
								<LessonOfferCard
									title={lesson.title}
									subtitle={lesson.subtitle}
									price={lesson.price}
									duration={lesson.duration}
									image={lesson.image}
									scope={lesson.scope}
									notes={lesson.notes}
								/>
							))
						}
					</div>
				</Container>
			</section>
		</main>

		<SiteFooter />
	</div>
</Layout>
