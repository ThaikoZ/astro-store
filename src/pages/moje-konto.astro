---
import AccountDashboard from '../components/account/AccountDashboard.astro';
import AccountEmpty from '../components/account/AccountEmpty.astro';
import AccountOrders from '../components/account/AccountOrders.astro';
import AccountProfile from '../components/account/AccountProfile.astro';
import AccountSettings from '../components/account/AccountSettings.astro';
import AccountShell from '../components/account/AccountShell.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import SiteHeader from '../components/site/SiteHeader.astro';
import Container from '../components/ui/Container.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout title="Moje konto - Klaudia Jaranowska Makeup">
	<div class="min-h-full bg-foam text-ink md:bg-paper">
		<SiteHeader variant="solid" />
		<main class="pt-28 pb-16 md:pt-32 md:pb-24 lg:pb-28">
			<Container>
				<AccountShell>
					<AccountDashboard />
					<AccountProfile />
					<AccountEmpty panel="kursy" title="Kursy" />
					<AccountOrders />
					<AccountSettings />
				</AccountShell>
			</Container>
		</main>
		<SiteFooter />
	</div>
</Layout>

<script>
	import '../scripts/account-ui';
</script>
