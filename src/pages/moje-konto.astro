---
import AuthCard from '../components/site/AuthCard.astro';
import Button from '../components/ui/Button.astro';
import AuthPage from '../layouts/AuthPage.astro';
---

<AuthPage title="Moje konto - Klaudia Jaranowska Makeup">
	<div data-auth-account>
		<AuthCard title="Moje konto" subtitle="Jesteś zalogowana.">
			<p class="m-0 text-center font-sans text-sm leading-relaxed text-ink/65">
				Pełny panel konta (zamówienia, adresy) pojawi się w kolejnym kroku.
			</p>

			<p
				class="mt-4 m-0 hidden px-0 py-1 text-center font-sans text-sm leading-relaxed"
				data-auth-status
				hidden
			></p>

			<div class="mt-10 flex flex-col gap-3">
				<Button href="/" variant="ghost" tone="ink" class="w-full">
					Wróć na stronę główną
				</Button>
				<button
					type="button"
					class="inline-flex w-full cursor-pointer items-center justify-center border-0 bg-transparent px-8 py-3.5 font-sans text-xs tracking-[0.18em] text-ink/55 uppercase transition-opacity hover:text-ink hover:opacity-80"
					data-auth-logout
				>
					Wyloguj
				</button>
			</div>
		</AuthCard>
	</div>
</AuthPage>

<script>
	import '../scripts/auth-ui';
</script>
