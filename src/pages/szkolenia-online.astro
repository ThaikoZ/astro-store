---
import ProductCard from '../components/shop/ProductCard.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import SiteHeader from '../components/site/SiteHeader.astro';
import Container from '../components/ui/Container.astro';
import Layout from '../layouts/Layout.astro';
import { mapProductCard, type ProductCardModel } from '../lib/shop/mapProductCard';
import { createMemoryCookieAdapter, createWooClientFromEnv } from '../lib/woocommerce';

const woo = createWooClientFromEnv(
	{
		WORDPRESS_GRAPHQL_URL: import.meta.env.WORDPRESS_GRAPHQL_URL,
		PUBLIC_WORDPRESS_GRAPHQL_URL: import.meta.env.PUBLIC_WORDPRESS_GRAPHQL_URL,
		PUBLIC_APP_ORIGIN: import.meta.env.PUBLIC_APP_ORIGIN,
	},
	{
		cookies: createMemoryCookieAdapter(),
	},
);

let products: ProductCardModel[] = [];
let loadError: string | null = null;

try {
	const { products: result } = await woo.catalog.getProducts();
	const mapped: ProductCardModel[] = [];
	for (const node of result?.nodes ?? []) {
		const product = mapProductCard(node);
		if (product) mapped.push(product);
	}
	products = mapped;
} catch (error) {
	loadError =
		error instanceof Error
			? error.message
			: 'Nie udało się pobrać produktów. Spróbuj ponownie później.';
}
---

<Layout title="Szkolenia Online - Klaudia Jaranowska Makeup" withTopMargin>
	<div class="min-h-full bg-paper text-ink">
		<SiteHeader variant="solid" />

		<main>
			<section class="py-20 md:py-28" aria-labelledby="szkolenia-online-heading">
				<Container>
					<h1
						id="szkolenia-online-heading"
						class="m-0 text-center font-display text-[clamp(1.75rem,3.5vw,2.5rem)] font-normal tracking-[0.14em] text-ink uppercase"
					>
						Szkolenia Online
					</h1>

					{
						loadError ? (
							<p class="mx-auto mt-14 max-w-xl text-center font-sans text-sm leading-relaxed text-ink/70 md:text-base">
								Nie udało się wczytać szkolenia. Sprawdź połączenie z WordPress i spróbuj
								ponownie.
							</p>
						) : products.length === 0 ? (
							<p class="mx-auto mt-14 max-w-xl text-center font-sans text-sm leading-relaxed text-ink/70 md:text-base">
								Wkrótce pojawią się tu szkolenia online.
							</p>
						) : (
							<div class="mt-14 grid items-stretch gap-16 md:mt-16 md:grid-cols-2 md:gap-x-10 md:gap-y-16 lg:grid-cols-3 lg:gap-x-12 lg:gap-y-20">
								{products.map((product) => (
									<ProductCard product={product} />
								))}
							</div>
						)
					}
				</Container>
			</section>
		</main>

		<SiteFooter />
	</div>
</Layout>
