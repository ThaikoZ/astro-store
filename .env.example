WORDPRESS_GRAPHQL_URL=https://your-wordpress-site.example/graphql
# Browser auth uses same-origin proxy (see astro.config.mjs). Keep as /api/graphql in local dev.
PUBLIC_WORDPRESS_GRAPHQL_URL=/api/graphql
# WordPress site origin (no /graphql). Used for hosted checkout redirects.
PUBLIC_WORDPRESS_URL=https://your-wordpress-site.example
PUBLIC_APP_ORIGIN=http://localhost:4321
PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Cleanup account for npm run test:live (must be able to deleteOrder + deleteUser)
# Prefer a dedicated admin/shop-manager. WORDPRESS_TEST_* is accepted as fallback.
WORDPRESS_ADMIN_USER=
WORDPRESS_ADMIN_PASSWORD=
WORDPRESS_TEST_USER=
WORDPRESS_TEST_PASSWORD=

# Optional: enables live/coupons.integration.test.ts (create a matching coupon in WooCommerce)
WORDPRESS_TEST_COUPON=ASTROSDK
